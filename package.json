    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.39.0",
    "mongodb": "^7.3.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
